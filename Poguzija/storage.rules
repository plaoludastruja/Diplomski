rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Recipe photos: viewable by everyone (recipes are public), uploadable
    // only by signed-in users, and only actual images up to 10MB.
    match /foodRecipesPhotos/{imageId} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
